[Unit]
Description=modbus-ui - Modbus register browser
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=modbus
Group=modbus
WorkingDirectory=/opt/modbus-ui/app
Environment=LISTEN_PORT=8080
Environment=CONFIG_FILE=/etc/modbus-ui/config.json
Environment=AUDIT_FILE=/var/lib/modbus-ui/audit.jsonl
ExecStart=/usr/bin/python3 -u /opt/modbus-ui/app/server.py
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/modbus-ui
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
